# ==============================================================================
#  aosp-a10 · build configuration
#  One file to rule the whole build. Every script sources this.
# ==============================================================================

# ---- ROM / device identity ---------------------------------------------------
MANIFEST_URL="https://github.com/keepQASSA/manifest"
MANIFEST_BRANCH="Q"
LUNCH_COMBO="qassa_PL2-userdebug"
DEVICE="PL2"                                # Nokia 6.1 (PL2 / PL2_sprout / Plate2)
DEVICE_PATH="device/nokia/PL2"
ROM_NAME="QASSA 2.4"

# ---- Device sources -----------------------------------------------------------
# How the 4 device repos land in the tree:
#   direct   -> after `repo sync`, wipe the paths and shallow-clone them directly
#               (mirrors the exact flow that was proven to work on Colab; no
#               local_manifest merge conflicts possible)
#   manifest -> copy config/local_manifests/*.xml into .repo/local_manifests
#               before `repo sync` (cleaner, but fails if the ROM manifest
#               already defines any of the same projects)
DEVICE_CLONE_MODE="direct"
LOCAL_MANIFEST_SRC="config/local_manifests/qassa_pl2.xml"

# path-in-tree|clone-url|branch   (used by the direct mode + fallback verifier)
DEVICE_REPOS_FILE="config/device_repos.txt"

# ---- Performance budgets (tuned for a 4 vCPU / 16 GB GitHub runner) ----------
SYNC_JOBS="8"                 # GitHub-hosted runners sync from GitHub fast
BUILD_JOBS=""                 # reserved for local make usage; in CI soong_ui
                              # auto-tunes parallelism to the runner's cores
CCACHE_SIZE="10G"             # logical cap; physical ~6 GB with compression on
SWAP_SIZE="8G"                # RAM spike absorber (soong gen + parallel lld)
BUILD_SLICE_SECONDS="${BUILD_SLICE_SECONDS:-9600}"   # 160 min build budget/job
WITH_DEXPREOPT="false"        # massive time + disk saver; boot a bit slower

# ---- Storage guards -----------------------------------------------------------
MIN_FREE_GB_WARN="10"
MIN_FREE_GB_ABORT="4"

# ---- Paths (AOSP tree lives OUTSIDE the tool repo) -----------------------------
AOSP_ROOT="${AOSP_ROOT:-$HOME/aosp}"
CCACHE_DIR="${CCACHE_DIR:-$HOME/.ccache}"

# ---- Behavior ------------------------------------------------------------------
STRIP_GIT="true"              # drop .git/.repo after sync (saves 4-8 GB,
                              # we never incrementally sync; force_sync re-inits)
