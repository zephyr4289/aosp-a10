 fi
 
-_log "Publishing to release '${TAG}' (delete + recreate for atomicity)..."
-release_reset "$TAG" "$TITLE" "$NOTES"
-release_upload "$TAG" "$STAGE"/*
-_ok "release '${TAG}' now carries $(ls "$STAGE" | wc -l) assets ($(du -sh "$STAGE" | cut -f1))"
