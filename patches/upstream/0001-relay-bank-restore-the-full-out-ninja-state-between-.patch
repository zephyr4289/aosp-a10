 #!/usr/bin/env bash
 # ==============================================================================
-#  04_upload_cache.sh <src|ccache> — persist state into GitHub Releases
+#  04_upload_cache.sh <src|ccache|out> — persist state into GitHub Releases
 #
-#  Why Releases and not actions/cache?
-#    * actions/cache caps at 10 GB/repo with LRU eviction — a source tree or a
-#      hot ccache does not fit and can silently vanish mid-campaign.
-#    * Release assets on public repos are free, 2 GiB each; we split archives
-#      into 1.9 GB parts and reset the release each time (no stale parts).
+#  NEW 'out' MODE (the anti-linear-redo fix): banks the ENTIRE ninja build
+#  state — out/ including .ninja_log and mtimes, minus rebuild-cheap fat
+#  (symbols dirs etc.). The next slice's ninja skips every finished output
+#  regardless of language. ccache alone only covers C/C++ and re-paid soong
+#  analysis + all Java/Kotlin/proto/dex/packaging work every slice — the
+#  "redo grows linearly with slice number" pathology.
+#
+#  'src' mode also switched to the zero-staging streaming path (lib_stream.sh)
+#  so pack parts never share a disk with the tree+out again.
 # ==============================================================================
 source "$(dirname "$0")/lib.sh"
 
-MODE="${1:?usage: 04_upload_cache.sh <src|ccache>}"
-STAGE="$HOME/.upload-${MODE}"
+MODE="${1:?usage: 04_upload_cache.sh <src|ccache|out>}"
 
