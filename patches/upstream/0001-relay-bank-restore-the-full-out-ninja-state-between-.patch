   [ -f "${AOSP_ROOT}/.source_ready" ] || { _warn "source not ready — nothing to upload"; exit 0; }
-  TAG="source-cache"
-  TITLE="Source cache — QASSA ${MANIFEST_BRANCH} (shallow, git-stripped)"
-  NOTES="Auto-generated source snapshot. Restored by scripts/05_restore_cache.sh. Do not delete unless you want the next run to re-sync from scratch."
-  MEMBER="aosp"
+  export RELAY_TAG="source-cache"
+  export RELAY_MEMBER="aosp"
+  export RELAY_EXCLUDES="aosp/out"
+  bash "$(dirname "$0")/lib_stream.sh" push
+
 elif [ "$MODE" = "ccache" ]; then
   [ -d "${CCACHE_DIR}" ] || { _warn "no ccache dir — nothing to upload"; exit 0; }
   CC_SIZE="$(du -sm "${CCACHE_DIR}" | cut -f1)"
   [ "$CC_SIZE" -gt 50 ] || { _ok "ccache nearly empty (${CC_SIZE} MB) — skipping upload"; exit 0; }
-  TAG="ccache-cache"
-  TITLE="ccache — ${LUNCH_COMBO}"
-  NOTES="Compiler cache carried between build slices. Deleting this tag resets to a cold build."
-  MEMBER=".ccache"
-else
-  _die "unknown mode '${MODE}' (expected src|ccache)"
-fi
+  # ccache kept for compatibility; with the out/ relay it is optional.
+  STAGE="$HOME/.upload-ccache"
+  check_disk "before packing ccache"
+  rm -rf "$STAGE"
+  pack_split "$HOME" ".ccache" "$STAGE" "ccache"
+  release_reset "ccache-cache" "ccache — ${LUNCH_COMBO}" \
+    "Compiler cache carried between build slices. Deleting this tag resets to a cold build."
+  release_upload "ccache-cache" "$STAGE"/*
+  rm -rf "$STAGE"
+
+elif [ "$MODE" = "out" ]; then
+  [ -d "${AOSP_ROOT}/out" ] || { _warn "no out/ dir — nothing to bank"; exit 0; }
+  SLICE_NO="${FORGE_SLICE_NO:-1}"
+  export RELAY_TAG="state-cache-s${SLICE_NO}"
+  export RELAY_MEMBER="aosp/out"
+  # rebuild-cheap fat never travels; ninja re-runs those copy rules in minutes
+  export RELAY_EXCLUDES="aosp/out/target/product/*/symbols aosp/out/target/product/*/obj/*/oat_x86* aosp/out/soong/.temp-dir*"
+  bash "$(dirname "$0")/lib_stream.sh" push
+  # keep exactly two generations: resume safety without storage creep
+  _log "pruning old state-cache tags (keep newest 2)..."
+  for tag in $(gh release list --limit 100 --json tagName -q '.[].tagName' 2>/dev/null \
+               | grep '^state-cache-s' | grep -v "s${SLICE_NO}$" | sort -V | head -n -1); do
+    _warn "dropping stale state tag ${tag}"
+    gh release delete "$tag" --yes --cleanup-tag >/dev/null 2>&1 || true
+  done
 
