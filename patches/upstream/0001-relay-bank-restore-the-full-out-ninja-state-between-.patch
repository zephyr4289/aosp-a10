-rm -rf "$STAGE"
-if [ "$MODE" = "src" ]; then
-  pack_split "$HOME" "$MEMBER" "$STAGE" "$MODE" "aosp/out"   # never cache intermediates
 else
-  pack_split "$HOME" "$MEMBER" "$STAGE" "$MODE"
