+# ------------------------------- out/ state ------------------------------------
+# Exact-resume relay: restores the banked ninja state so the slice continues
+# where the previous one stopped (any language). This is what eliminates the
+# linear per-slice re-do of soong analysis + Java/dex work.
+if release_exists "state-cache-s999999"; then :; fi   # probe warm (no-op)
+
+NEWEST_STATE="$(gh release list --limit 100 --json tagName -q '.[].tagName' 2>/dev/null \
+                | grep '^state-cache-s' | sort -V | tail -1 || true)"
+if [ -n "$NEWEST_STATE" ] && [ "${FRESH_STATE:-false}" != "true" ]; then
+  _log "Restoring out/ ninja state from ${NEWEST_STATE} (exact resume)..."
+  mkdir -p "${AOSP_ROOT}"
+  RELAY_TAG="$NEWEST_STATE" RELAY_MEMBER="aosp/out" RELAY_DEST="${AOSP_ROOT}" \
+    bash "$(dirname "$0")/lib_stream.sh" pull
+  [ -f "${AOSP_ROOT}/out/.ninja_log" ] \
+    || _die "state ${NEWEST_STATE} restored but .ninja_log missing — corrupt state tag, delete it and rerun"
+  out state "$NEWEST_STATE"
+else
+  _log "no banked out/ state — cold slice (or FRESH_STATE)"
+  out state miss
+fi
+
 # ------------------------------- ccache -------------------------------------------
 if [ "${FRESH_CCACHE}" = "true" ]; then
   _log "FRESH_CCACHE set — starting with a cold compiler cache"
diff --git a/scripts/lib_stream.sh b/scripts/lib_stream.sh
new file mode 100644
index 0000000..efe488d
--- /dev/null
+++ b/scripts/lib_stream.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# ==============================================================================
+#  lib_stream.sh — zero-staging archive-to-release streaming
+#
+#  Usage: RELAY_TAG=<release-tag> RELAY_MEMBER=<tar-member> \
+#         [RELAY_EXCLUDES="a b c"] bash lib_stream.sh push
+#
+#  Streams:  tar | zstd | split --filter 'gh release upload'
+#  so split parts never accumulate on the runner disk (the structural fix
+#  for ENOSPC-at-94%: upstream staged ~20 GB of parts beside tree+out).
+#  Each part's sha256 is appended to SHA256SUMS which is uploaded last.
+# ==============================================================================
+set -euo pipefail
+source "$(dirname "$0")/lib.sh"
+
+: "${RELAY_TAG:?RELAY_TAG not set}"
+: "${RELAY_MEMBER:?RELAY_MEMBER not set}"
+RELAY_EXCLUDES="${RELAY_EXCLUDES:-}"
+MODE="${1:-push}"
+
+_exclude_args() {
+  local args=""
+  for e in $RELAY_EXCLUDES; do
+    args="$args --exclude $e"
+  done
+  # shellcheck disable=SC2086
+  echo "$args"
+}
+
+if [ "$MODE" = "push" ]; then
+  # ensure the release exists
+  release_exists "$RELAY_TAG" || \
+    release_reset "$RELAY_TAG" "state ${RELAY_TAG}" \
+      "Auto-generated by lib_stream.sh. Keep only the newest two state tags."
+
+  SUMS="$HOME/.relay_sums.$$"
+  : > "$SUMS"
+
+  # the --filter command receives the chunk on STDIN and must WRITE $FILE
+  # itself (GNU split --filter semantics), then bank it and remove it.
+  FILTER_CMD='
+    set -e
+    cat > "$FILE"
+    sha256sum "$FILE" >> "'"${SUMS}"'"
+    ok=0
+    for i in 1 2 3; do
+      if gh release upload "'"${RELAY_TAG}"'" "$FILE" -R "${GITHUB_REPOSITORY:-}" --clobber; then ok=1; break; fi
+      sleep 20
+    done
+    [ "$ok" = "1" ] || exit 1
+    rm -f "$FILE"
+  '
+  export FILTER_CMD
+
+  # shellcheck disable=SC2086
+  if ! tar -C "$HOME" $(_exclude_args) -cf - "${RELAY_MEMBER}" \
+       | zstd -T0 -3 -c \
+       | split -b 1900M --filter "$FILTER_CMD" - relay.part.; then
+    rm -f "$SUMS"
+    _die "stream pack to ${RELAY_TAG} failed"
+  fi
+
+  cp "$SUMS" "$HOME/SHA256SUMS"
+  rm -f "$SUMS"
+  release_upload "$RELAY_TAG" "$HOME/SHA256SUMS"
+  rm -f "$HOME/SHA256SUMS"
+  _ok "streamed ${RELAY_MEMBER} -> release ${RELAY_TAG} (zero staging)"
+
+elif [ "$MODE" = "pull" ]; then
+  : "${RELAY_DEST:?RELAY_DEST not set (target dir for member contents)}"
+  DL="$HOME/.relay-dl.$$"
+  rm -rf "$DL"; mkdir -p "$DL"
+  release_fetch "$RELAY_TAG" "relay.part.*" "$DL" \
+    || _die "release ${RELAY_TAG} has no parts"
+  release_fetch "$RELAY_TAG" "SHA256SUMS" "$DL" || true
+  cat "$DL"/relay.part.* | zstd -d -T0 -c | tar -C "$RELAY_DEST" -xf - \
+    || _die "stream unpack from ${RELAY_TAG} failed"
+  rm -rf "$DL"
+  _ok "streamed ${RELAY_TAG} -> ${RELAY_DEST}"
+fi
