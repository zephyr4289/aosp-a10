From 91d97d9cfa8f21dc90fe1d25fa5d4cafcbabf6ea Mon Sep 17 00:00:00 2001
From: ROMForge Engineering <romforge@users.noreply.github.com>
Date: Tue, 22 Sep 2026 19:41:46 +0000
Subject: [PATCH 2/2] env: auto-relocate workdir to the largest mount
 (anti-ENOSPC)

Runners expose ~14-25 GB on / but ~65 GB on /mnt; the fixed $HOME/aosp
workdir is what hit ENOSPC at the 94% link. lib.sh now picks the mount
with the most free space (marker file keeps it stable across scripts)
and honors any explicitly configured AOSP_ROOT.
---
 scripts/lib.sh | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/scripts/lib.sh b/scripts/lib.sh
index 384ce85..64517dd 100755
--- a/scripts/lib.sh
+++ b/scripts/lib.sh
@@ -18,6 +18,41 @@ _warn() { printf '\033[1;33m[%s] ⚠ %s\033[0m\n' "$(date -u +%H:%M:%S)" "$*" >&
 _die()  { printf '\033[1;31m[%s] ✖ %s\033[0m\n' "$(date -u +%H:%M:%S)" "$*" >&2; exit 1; }
 _hr()   { printf '%s\n' "--------------------------------------------------------------------------------"; }
 
+# ---- auto workdir (anti-ENOSPC) -----------------------------------------------
+# GitHub runners have ~14-25 GB free on / but ~65 GB free on /mnt. The
+# default $HOME/aosp workdir is what put the inherited pipeline into ENOSPC
+# at the 94% link. Relocate AOSP_ROOT (and ccache) to the mount with the
+# most free space, once, stably (marker file keeps it consistent across
+# scripts/jobs). Override: FORGE_AUTO_WORKDIR=false.
+_pick_workdir() {
+  [ "${FORGE_AUTO_WORKDIR:-true}" = "true" ] || return 0
+  local best="" best_free=0 p free marker="${HOME}/.forge-workdir"
+  # honor an explicit non-default AOSP_ROOT from the environment/config
+  [ -n "${AOSP_ROOT:-}" ] && [ "${AOSP_ROOT}" != "${HOME}/aosp" ] && return 0
+  for p in /mnt /media/userdata /; do
+    [ -d "$p" ] && [ -w "$p" ] || continue
+    free=$(df -BG --output=avail "$p" 2>/dev/null | tail -1 | tr -dc '0-9')
+    [ -z "$free" ] && continue
+    if [ "$free" -gt "$best_free" ]; then best_free=$free; best=$p; fi
+  done
+  [ -n "$best" ] || return 0
+  # only move if the chosen mount clearly beats the current one
+  local home_free
+  home_free=$(df -BG --output=avail "$HOME" 2>/dev/null | tail -1 | tr -dc '0-9')
+  home_free=${home_free:-0}
+  if [ "$best_free" -gt $((home_free + 30)) ]; then
+    AOSP_ROOT="${best}/aosp"
+    CCACHE_DIR="${best}/.ccache"
+    printf 'AOSP_ROOT=%s\nCCACHE_DIR=%s\n' "$AOSP_ROOT" "$CCACHE_DIR" > "$marker"
+    _log "workdir relocated to ${best} (${best_free}G free vs ${home_free}G on \$HOME)"
+  fi
+}
+if [ -f "${HOME}/.forge-workdir" ]; then
+  # shellcheck disable=SC1091
+  . "${HOME}/.forge-workdir"
+fi
+_pick_workdir
+
 # ---- GITHUB_OUTPUT writer (no-op outside GitHub Actions) -----------------------
 out() {  # out <name> <value>
   if [ -n "${GITHUB_OUTPUT:-}" ]; then
-- 
